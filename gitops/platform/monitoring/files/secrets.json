{
  "title": "Odoo Secrets and Rotation",
  "uid": "odoo-secrets",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "OpenBao Ready members",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_statefulset_status_replicas_ready{namespace=\"openbao\",statefulset=\"openbao\"}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Raft leadership",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(pod) (vault_core_active{namespace=\"openbao\"})"
        }
      ]
    },
    {
      "id": 3,
      "title": "ESO replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"external-secrets\",deployment=\"external-secrets\"}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Credential remaining seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "odoo_secret_credential_remaining_seconds{namespace=\"secrets-system\"}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Rotation in progress",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "odoo_secret_rotation_in_progress{namespace=\"secrets-system\"}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Guard heartbeat age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-odoo_secret_guard_last_success_timestamp_seconds{namespace=\"secrets-system\",service=\"secret-expiry-guard\"}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Connections per login",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "odoo_secret_connections{namespace=\"secrets-system\",service=\"secret-rotator\"}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Snapshot age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-max(kube_job_status_completion_time{namespace=\"openbao\",job_name=~\"openbao-snapshot.*\"})"
        }
      ]
    },
    {
      "id": 10,
      "title": "Cron heartbeat age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-max(odoo_odoo_cron_heartbeat_timestamp_seconds)"
        }
      ]
    },
    {
      "id": 11,
      "title": "Session health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "odoo_odoo_session_up"
        }
      ]
    },
    {
      "id": 12,
      "title": "NFS free bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "odoo_odoo_shared_storage_free_bytes"
        }
      ]
    },
    {
      "id": 100,
      "title": "Database authentication failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(odoo_odoo_database_authentication_failures_total[5m]))"
        }
      ]
    },
    {
      "id": 101,
      "title": "Unsealed members",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(pod) (vault_core_unsealed{namespace=\"openbao\"})"
        }
      ]
    }
  ]
}
